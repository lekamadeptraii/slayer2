-- Discord Webhook (Dynamic getgenv().webhook Loader & Multi-Executor Support)
local function getWebhookUrl()
    local genv = (typeof(getgenv) == "function" and getgenv()) or {}
    local raw = genv.webhook or genv.Webhook or genv.WEBHOOK or _G.webhook or _G.Webhook or _G.WEBHOOK
    if typeof(raw) == "string" and raw ~= "" then
        local clean = string.gsub(raw, "%s+", "")
        if string.find(clean, "discord") and string.find(clean, "webhooks") then
            return clean
        end
    end
    return nil
end

local function executeHttpRequest(payload)
    local targetUrl = getWebhookUrl()
    if not targetUrl then return end

    local req = (syn and syn.request) or (http and http.request) or http_request or request or (fluxus and fluxus.request)
    if typeof(req) ~= "function" then return end

    local HttpService = game:GetService("HttpService")
    local bodyJson = HttpService:JSONEncode(payload)

    for attempt = 1, 3 do
        local ok, res = pcall(function()
            return req({
                Url = targetUrl,
                url = targetUrl,
                Method = "POST",
                method = "POST",
                Headers = {
                    ["Content-Type"] = "application/json"
                },
                headers = {
                    ["Content-Type"] = "application/json"
                },
                Body = bodyJson,
                body = bodyJson
            })
        end)
        if ok and res and (res.StatusCode == 200 or res.StatusCode == 204 or res.Success) then
            break
        end
        task.wait(1)
    end
end

