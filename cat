local function acceptConfirmationPopups()
    local pGui = LocalPlayer:FindFirstChild("PlayerGui")
    if not pGui then return false end

    local clicked = false

    -- 1. Bắt chính xác popup thông báo câu hỏi trong MenuPopups (QuestionCounter / QuestionStrip / Popup...)
    pcall(function()
        local popups = pGui:FindFirstChild("MenuPopups")
        if popups then
            for _, desc in ipairs(popups:GetDescendants()) do
                if desc:IsA("TextButton") or desc:IsA("ImageButton") then
                    local isConfirm = false
                    local parent = desc.Parent

                    -- Kiểm tra nền nút màu xanh lá (Green > Red: nút đồng ý / Yes)
                    local bg = (parent and parent:FindFirstChild("BG")) or desc:FindFirstChild("BG")
                    if bg and bg:IsA("GuiObject") and bg.BackgroundColor3.G > bg.BackgroundColor3.R then
                        isConfirm = true
                    end

                    -- Kiểm tra icon check xanh (checkmark rbxassetid://86786939359303)
                    local img = (parent and parent:FindFirstChildWhichIsA("ImageLabel", true)) or desc:FindFirstChildWhichIsA("ImageLabel", true)
                    if img and (string.find(tostring(img.Image), "86786939359303") or string.find(string.lower(tostring(img.Image)), "check")) then
                        isConfirm = true
                    end

                    -- Kiểm tra nếu nằm trong ZButtonsHolder và là nút đầu tiên (nút Yes bên trái)
                    local zb = desc:FindFirstAncestor("ZButtonsHolder")
                    if zb then
                        local frames = {}
                        for _, child in ipairs(zb:GetChildren()) do
                            if child:IsA("Frame") then
                                table.insert(frames, child)
                            end
                        end
                        if #frames > 0 and (desc:IsDescendantOf(frames[1]) or desc.Parent == frames[1]) then
                            isConfirm = true
                        end
                    end

                    if isConfirm then
                        clickButtonSafe(desc)
                        clicked = true
                    end
                end
            end
        end
    end)

    -- 2. Quét dự phòng toàn bộ PlayerGui nếu có dialog xác nhận code khác
    pcall(function()
        for _, desc in ipairs(pGui:GetDescendants()) do
            if desc:IsA("TextButton") or desc:IsA("ImageButton") then
                local txt = string.lower(desc:IsA("TextButton") and desc.Text or "")
                if txt == "yes" or txt == "đồng ý" or txt == "chấp nhận" or txt == "confirm" or txt == "accept" then
                    if not desc:IsDescendantOf(pGui:FindFirstChild("Components", true)) or desc:FindFirstAncestor("MenuPopups") then
                        clickButtonSafe(desc)
                        clicked = true
                    end
                end
            end
        end
    end)

    return clicked
end

