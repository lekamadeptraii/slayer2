-- 4. TURBO AUTOMATED KAITUN FLOW (HIGH SPEED ROLL)
task.spawn(function()
    for _ = 1, 3 do
        local curClan, spins = fetchPlayerData()
        cachedSpins = spins
        clanLbl.Text = curClan
        spinsLbl.Text = tostring(spins)
        if curClan ~= "N/A" and spins > 0 then break end
        task.wait(0.1)
    end

    local curClan, spins = fetchPlayerData()
    if TARGET_CLANS[curClan] then
        isLocked = true
        saveAccountStatus(LocalPlayer.Name, curClan)
        statusText.Text = "Already have " .. curClan:upper() .. " (0.1%)!"
        statusText.TextColor3 = Color3.fromRGB(255, 215, 0)
        statusDot.BackgroundColor3 = Color3.fromRGB(255, 215, 0)
        clanLbl.TextColor3 = Color3.fromRGB(255, 215, 0)
        return
    end

    -- STEP 1: REDEEM PROMO CODES (AUTO-ACCEPT CONFIRMATION POPUPS)
    statusText.Text = "Redeeming codes..."
    statusText.TextColor3 = Color3.fromRGB(255, 200, 50)
    statusDot.BackgroundColor3 = Color3.fromRGB(255, 200, 50)

    local autoAcceptActive = true
    task.spawn(function()
        while autoAcceptActive do
            acceptConfirmationPopups()
            task.wait(0.04)
        end
    end)

    for _, code in ipairs(CODES) do
        task.spawn(function()
            pcall(SignalFunction.ToServer, "RedeemCode", code)
        end)

        local startWait = tick()
        while tick() - startWait < 1.2 do
            if acceptConfirmationPopups() then
                task.wait(0.15)
                break
            end
            task.wait(0.05)
        end
        task.wait(0.1)
    end

    pcall(SignalFunction.ToServer, "CodeStatus")
    task.wait(0.3)
    autoAcceptActive = false

    local _, updatedSpins = fetchPlayerData()
    cachedSpins = updatedSpins > 0 and updatedSpins or 105

    spinsLbl.Text = tostring(cachedSpins)
    statusText.Text = "Turbo Rolling..."
    statusText.TextColor3 = Color3.fromRGB(80, 220, 100)
    statusDot.BackgroundColor3 = Color3.fromRGB(80, 220, 100)
    task.wait(0.1)

    -- STEP 2: TURBO ZERO-DELAY AUTO ROLL
    local failAttempts = 0

    while not isLocked do
        local success, rolledClan = pcall(SignalFunction.ToServer, "ClanSpin")

        if success and typeof(rolledClan) == "string" and rolledClan ~= "" then
            failAttempts = 0
            
            task.spawn(function()
                pcall(SignalEvent.ToServer, "ClanSpinComplete")
            end)

            cachedSpins = math.max(0, cachedSpins - 1)
            rollCount = rollCount + 1

            lastRollLbl.Text = rolledClan
            clanLbl.Text = rolledClan
            spinsLbl.Text = tostring(cachedSpins)
            countLbl.Text = rollCount .. " rolls"

            -- CHECK TARGET 0.1% CLAN HIT
            if TARGET_CLANS[rolledClan] then
                isLocked = true
                saveAccountStatus(LocalPlayer.Name, rolledClan)

                statusText.Text = "ROLLED " .. rolledClan:upper() .. " (0.1%)! STOPPED."
                statusText.TextColor3 = Color3.fromRGB(255, 215, 0)
                statusDot.BackgroundColor3 = Color3.fromRGB(255, 215, 0)
                clanLbl.TextColor3 = Color3.fromRGB(255, 215, 0)
                lastRollLbl.TextColor3 = Color3.fromRGB(255, 215, 0)

                pcall(function()
                    StarterGui:SetCore("SendNotification", {
                        Title = "CAT HUB KAITUN",
                        Text = "CONGRATULATIONS! ROLLED " .. rolledClan:upper() .. "!",
                        Duration = 20
                    })
                end)
                break
            end
        else
            failAttempts = failAttempts + 1
            if failAttempts >= 5 then
                local _, realSpins = fetchPlayerData()
                if realSpins > 0 then
                    cachedSpins = realSpins
                    spinsLbl.Text = tostring(cachedSpins)
                    failAttempts = 0
                else
                    isLocked = true
                    statusText.Text = "Out of spins (0 Spins remaining)!"
                    statusText.TextColor3 = Color3.fromRGB(220, 70, 70)
                    statusDot.BackgroundColor3 = Color3.fromRGB(220, 70, 70)
                    break
                end
            end
        end

        -- Giảm thời gian chờ xuống mức thấp nhất để tăng tốc độ roll
        task.wait(0.005)
    end
end)
