    task.wait(0.3)

    -- STEP 2: ZERO-DELAY AUTO ROLL
    statusText.Text = "Auto rolling (Instant skip)..."
    statusText.TextColor3 = Color3.fromRGB(80, 200, 255)
    statusDot.BackgroundColor3 = Color3.fromRGB(80, 200, 255)

    local failAttempts = 0

    while not isLocked do
        local success, rolledClan = pcall(SignalFunction.ToServer, "ClanSpin")

        if success and typeof(rolledClan) == "string" and rolledClan ~= "" then
            failAttempts = 0
            
            task.spawn(function()
                pcall(SignalEvent.ToServer, "ClanSpinComplete")
            end)

            cachedSpins = math.max(0, cachedSpins - 1)
            rollCount = rollCount + 1

            lastRollLbl.Text = rolledClan
            clanLbl.Text = rolledClan
            spinsLbl.Text = tostring(cachedSpins)
            countLbl.Text = rollCount .. " rolls"

            -- CHECK TARGET 0.1% CLAN HIT
            if TARGET_CLANS[rolledClan] then
                isLocked = true
                saveAccountStatus(LocalPlayer.Name, rolledClan)

                statusText.Text = "ROLLED " .. rolledClan:upper() .. " (0.1%)! STOPPED."
                statusText.TextColor3 = Color3.fromRGB(255, 215, 0)
                statusDot.BackgroundColor3 = Color3.fromRGB(255, 215, 0)
                clanLbl.TextColor3 = Color3.fromRGB(255, 215, 0)
                lastRollLbl.TextColor3 = Color3.fromRGB(255, 215, 0)

                pcall(function()
                    StarterGui:SetCore("SendNotification", {
                        Title = "CAT HUB KAITUN",
                        Text = "CONGRATULATIONS! ROLLED " .. rolledClan:upper() .. "!",
                        Duration = 20
                    })
                end)
                break
            end
        else
            failAttempts = failAttempts + 1
            local _, realSpins = fetchPlayerData()
            if realSpins > 0 then
                cachedSpins = realSpins
                spinsLbl.Text = tostring(cachedSpins)
            end

            if failAttempts >= 3 and (cachedSpins <= 0 or not success) then
                isLocked = true
                statusText.Text = "Out of spins (0 Spins remaining)!"
                statusText.TextColor3 = Color3.fromRGB(220, 70, 70)
                statusDot.BackgroundColor3 = Color3.fromRGB(220, 70, 70)
                break
            end
            task.wait(0.2)
        end

        task.wait(0.03)
    end
end)
